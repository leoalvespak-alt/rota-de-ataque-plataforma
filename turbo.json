{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "dev": { "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["build", "^build"], "outputs": [] },
    "test": { "dependsOn": ["build", "^build"], "outputs": ["coverage/**"] },
    "test:e2e": { "dependsOn": ["build", "^build"], "outputs": ["test-results/**", "playwright-report/**"] },
    "lint": { "dependsOn": ["build", "^build"], "outputs": [] },
    "tokens:build": { "outputs": ["src/tokens/build/**"] }
  }
}
