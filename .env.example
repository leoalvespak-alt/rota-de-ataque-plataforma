# Meta / Instagram Graph API
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v26.0
META_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_BUSINESS_ACCOUNT_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_FACEBOOK_PAGE_ID=
META_WEBHOOK_VERIFY_TOKEN=
THREADS_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
REDDIT_REFRESH_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
PII_HASH_SALT=
EMAIL_FROM="Rota de Ataque <contato@example.com>"
RESEND_WEBHOOK_SECRET=
EMAIL_SES_WEBHOOK_SECRET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WHATSAPP_GROUPS_AVAILABLE=false
META_GRAPH_BASE_URL=https://graph.facebook.com

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=prospector
POSTGRES_USER=prospector
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://prospector:change-me@postgres:5432/prospector

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# Playwright
CHROMIUM_PROFILES_DIR=/data/chromium_profiles
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOWMO_MS=0

# S3-compatible
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=prospector-snapshots
S3_BUCKET_SNAPSHOTS=prospector-snapshots
S3_BUCKET_BACKUPS=prospector-backups
BACKUP_ENCRYPTION_KEY=
S3_PUBLIC_BUCKET=prospector-public
S3_PUBLIC_BASE_URL=

# LLM / embeddings (embeddings externos são proibidos)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_ENDPOINT=
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_ENDPOINT=http://embeddings:8080
EMBEDDING_DIM=384

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_MIN_SEVERITY=warn
RESEND_API_KEY=
RESEND_FROM="Prospector Alerts <alerts@example.com>"
ALERTS_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERTS_EMAIL_ESCALATION_TO=
ALERTS_EMAIL_MIN_SEVERITY=error
ALERTS_DEDUP_WINDOW_SECONDS=900
ALERTS_RATE_LIMIT_PER_MINUTE=30
ALERTS_ESCALATION_AFTER_SECONDS=1800

# App / auth / security
APP_URL=https://prospector.example.com
NEXTAUTH_SECRET=
NEXTAUTH_URL=${APP_URL}
OTP_SECRET=
AUTH_ADMIN_EMAILS=
AUTH_OPERATOR_EMAILS=
TOKEN_ENCRYPTION_KEY=
NODE_ENV=production
LOG_LEVEL=info
SENTRY_DSN=

# Runtime / thresholds
TZ=America/Fortaleza
SCORING_LAMBDA_FRESHNESS=0.05
PRIORITY_P0_THRESHOLD=80
PRIORITY_P1_THRESHOLD=50
PRIORITY_P2_THRESHOLD=25
EXTRACTION_MIN_SUCCESS_RATE=0.90
EXTRACTION_MIN_COVERAGE=0.60
DM_WINDOW_HOURS=24

# All workers use explicit kill switches and start disabled
WORKERS_DEFAULT_ENABLED=false
MIGRATIONS_CURRENT=true
META_TOKEN_VALID=false
WORKER_DISCOVERY_ENABLED=false
WORKER_EXTRACTION_ENABLED=false
WORKER_META_SYNC_ENABLED=false
WORKER_META_WEBHOOK_CONSUMER_ENABLED=false
WORKER_CLASSIFICATION_ENABLED=false
WORKER_SCORING_ENABLED=false
WORKER_ENRICHMENT_ENABLED=false
WORKER_ENGAGEMENT_ENABLED=false
WORKER_DM_COPILOT_ENABLED=false
WORKER_CONVERSATION_AGENT_ENABLED=false
WORKER_PRIVATE_REPLY_ENABLED=false
WORKER_MENTION_MONITOR_ENABLED=false
WORKER_RECIPROCITY_DETECTOR_ENABLED=false
WORKER_NBA_ENGINE_ENABLED=false
