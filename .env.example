# =============================================================================
# Rota de Ataque — Template de Variáveis de Ambiente
# Copie para .env.production e preencha os valores reais.
# Este arquivo SIM é commitado (sem valores reais).
# =============================================================================

# VPS — conexão SSH
VPS_HOST=
VPS_USER=root

# =============================================================================
# DESIGN SYSTEM
# =============================================================================

# Senha da tela de login
# Para ler o valor atual do VPS: ssh root@VPS "grep DESIGN_API_PASSWORD /opt/rota-design-api/shared/.env"
DESIGN_API_PASSWORD=

# Origem pública (CORS)
DESIGN_WEB_ORIGIN=https://design.rotadeataque.com.br

# IA — Design System
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
FAL_API_KEY=

# =============================================================================
# PROSPECTOR
# =============================================================================

# URLs públicas
APP_URL=https://design.rotadeataque.com.br/prospector
NEXTAUTH_URL=https://design.rotadeataque.com.br/prospector/api/auth
NEXT_PUBLIC_BASE_PATH=/prospector

# Acesso à plataforma — listas separadas por vírgula
AUTH_ADMIN_EMAILS=
AUTH_OPERATOR_EMAILS=
AUTH_BOOTSTRAP_VIEWER=false

# Meta / Instagram / Facebook
# App: RotaSystem-IG
# Callback OAuth: https://design.rotadeataque.com.br/prospector/api/meta/oauth/callback
# Webhook:        https://design.rotadeataque.com.br/prospector/api/meta/webhook
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCESS_TOKEN=
META_BUSINESS_ACCOUNT_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_FACEBOOK_PAGE_ID=
META_API_VERSION=v26.0
META_GRAPH_BASE_URL=https://graph.facebook.com
META_TOKEN_VALID=false

# Threads
THREADS_ACCESS_TOKEN=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
REDDIT_REFRESH_TOKEN=

# WhatsApp Cloud API
# Webhook: https://design.rotadeataque.com.br/prospector/api/whatsapp/webhook
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GROUPS_AVAILABLE=false

# Resend / e-mail
# Webhook: https://design.rotadeataque.com.br/prospector/api/email/webhook/resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_UNSUBSCRIBE_SECRET=
EMAIL_FROM=
RESEND_FROM=
ALERTS_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERTS_EMAIL_ESCALATION_TO=

# Amazon SES — opcional; deixe vazio se usar somente Resend
EMAIL_SES_WEBHOOK_SECRET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# IA — Prospector (LLM principal)
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_ENDPOINT=https://api.deepseek.com

# Configurações gerais de IA
AI_FALLBACK_TIMEOUT_MS=30000
AI_EMBEDDING_LOCAL_FALLBACK_ENABLED=true

# Provedores de IA alternativos — configure LLM_* acima para ativar um deles
ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=stepfun/step-3.5-flash:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=minimax-m2.7
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

WAFER_API_KEY=
WAFER_MODEL=DeepSeek-V4-Pro
WAFER_BASE_URL=https://pass.wafer.ai/v1

KIMI_API_KEY=
KIMI_MODEL=kimi-k2.5
KIMI_BASE_URL=https://api.moonshot.ai/v1

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Telegram — alertas operacionais (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# S3 / R2 Cloudflare — snapshots, mídia e backups
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=prospector-snapshots
S3_BUCKET_SNAPSHOTS=prospector-snapshots
S3_BUCKET_BACKUPS=prospector-backups
S3_PUBLIC_BUCKET=prospector-public
S3_PUBLIC_BASE_URL=

# Observabilidade (opcional)
SENTRY_DSN=

# Inteligência orgânica — provedores externos (opt-in)
EXA_ENABLED=false
EXA_API_KEY=
APIFY_ENABLED=false
APIFY_API_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=
APIFY_TIKTOK_ACTOR_ID=
APIFY_YOUTUBE_ACTOR_ID=
BRIGHT_DATA_ENABLED=false
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_DATASET_ID=
ORGANIC_DEEP_ANALYSIS_ENABLED=false
ORGANIC_AUTO_GENERATION_ENABLED=false
ORGANIC_AUTO_SCHEDULING_ENABLED=false
ORGANIC_LEARNING_RECOMMENDATIONS_ENABLED=false

# Workers — ativação individual (manter false até validar credenciais)
WORKER_META_SYNC_ENABLED=false
WORKER_META_WEBHOOK_CONSUMER_ENABLED=false
WORKER_REDDIT_INTELLIGENCE_ENABLED=false
WORKER_THREADS_ADAPTER_ENABLED=false
WORKER_THREADS_PUBLISHER_ENABLED=false
WORKER_EMAIL_FLOW_ENGINE_ENABLED=false
WORKER_EMAIL_EVENTS_CONSUMER_ENABLED=false
WORKER_WHATSAPP_INBOUND_ENABLED=false
WORKER_WHATSAPP_OUTBOUND_ENABLED=false
WORKER_IDENTITY_RESOLVER_ENABLED=false
WORKER_NEXT_BEST_CHANNEL_ENABLED=false
WORKER_CONTACT_POLICY_ENGINE_ENABLED=false
WORKER_ALERTS_ENABLED=false
WORKER_PUBLISHER_ENABLED=false
WORKER_CONTENT_ITEM_ORCHESTRATOR_ENABLED=false
SOURCE_ROI_AUTOAPPLY=false
