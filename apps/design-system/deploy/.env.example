# Copie este arquivo para deploy/.env e preencha somente na sua máquina.
# Não inclua senhas, tokens ou chaves privadas neste arquivo.
# deploy/.env NUNCA deve ser commitado (já está no .gitignore).

# VPS (compartilhado entre projetos: Rota de Ataque, Gazeta Concursos, Deriva, Design System)
VPS_HOST=seu-vps.exemplo
VPS_USER=usuario-administrativo

# Diretório do site no VPS (raiz servida pelo nginx)
VPS_TARGET_DIR=/var/www/design-rota-ataque

# Domínio do site (usado só para exibir a URL final no console)
VPS_DOMAIN=design.seu-dominio.exemplo
